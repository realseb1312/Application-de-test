# Image conteneur Windows pour Windows Server 2022 (conteneurs Windows, pas Docker Desktop).
# Beaucoup plus lourde qu'une image Linux : à utiliser si vous voulez vraiment Docker sur le serveur.
# Alternative recommandée sur Windows Server : installation native (voir README, section Windows Server 2022).
FROM mcr.microsoft.com/windows/servercore:ltsc2022

SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop';"]

# Installer Python 3.12 (ajouté au PATH système)
RUN Invoke-WebRequest -Uri https://www.python.org/ftp/python/3.12.7/python-3.12.7-amd64.exe -OutFile C:\py.exe; \
    Start-Process C:\py.exe -ArgumentList '/quiet InstallAllUsers=1 PrependPath=1' -Wait; \
    Remove-Item C:\py.exe

WORKDIR /app

COPY requirements.txt requirements-windows.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-windows.txt

COPY app.py db.py import_excel.py ./
COPY templates ./templates
COPY static ./static
COPY seed ./seed

ENV FDR_HOST=0.0.0.0 \
    FDR_PORT=8000

EXPOSE 8000

VOLUME ["C:/app/data"]

CMD ["python", "-m", "waitress", "--listen=0.0.0.0:8000", "app:app"]
