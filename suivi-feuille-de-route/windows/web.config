<?xml version="1.0" encoding="utf-8"?>
<!-- Site IIS "SuiviFDR" : reverse proxy vers l'app Waitress (127.0.0.1:8000).
     Necessite : ARR 3.0 + URL Rewrite installes, proxy ARR active.
     L'authentification Windows se configure AU NIVEAU DU SITE (par setup-site.ps1),
     volontairement PAS dans ce fichier : la section <authentication> y est verrouillée
     au niveau parent et provoque une erreur HTTP 500.19 (0x80070021). -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="VersAppSuiviFDR" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
