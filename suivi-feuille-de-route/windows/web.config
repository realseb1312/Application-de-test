<?xml version="1.0" encoding="utf-8"?>
<!-- Site IIS "SuiviFDR" : reverse proxy vers l'app Waitress (127.0.0.1:8000) + authentification Windows (SSO domaine).
     Necessite : rôle IIS + Application Request Routing (ARR) + URL Rewrite, et "Enable proxy" coche dans ARR. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="VersAppSuiviFDR" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <authentication>
        <windowsAuthentication enabled="true" />
        <anonymousAuthentication enabled="false" />
      </authentication>
    </security>
  </system.webServer>
</configuration>
